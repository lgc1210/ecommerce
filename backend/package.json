{
	"name": "backend",
	"version": "1.0.0",
	"description": "",
	"main": "dist/server.js",
	"type": "module",
	"scripts": {
		"dev": "cross-env NODE_ENV=development PORT=5000 tsx watch src/server.ts",
		"build": "prisma generate && tsc && node -e \"require('fs').cpSync('src/generated','dist/generated',{recursive:true})\"",
		"start": "cross-env NODE_ENV=production node dist/server.js",
		"db:migrate": "cross-env NODE_ENV=development prisma migrate dev",
		"db:generate": "cross-env NODE_ENV=development prisma generate",
		"db:studio": "cross-env NODE_ENV=development prisma studio",
		"db:reset": "cross-env NODE_ENV=development prisma migrate reset --force"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@prisma/adapter-mariadb": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"axios": "^1.19.0",
		"bcrypt": "^6.0.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"express": "^5.2.1",
		"google-auth-library": "^10.9.0",
		"helmet": "^8.2.0",
		"jsonwebtoken": "^9.0.3",
		"morgan": "^1.11.0",
		"multer": "^2.2.0",
		"node-cron": "^4.6.0",
		"nodemailer": "^9.0.3",
		"zod": "^4.4.3",
		"swagger-ui-express": "^5.0.1"
	},
	"devDependencies": {
		"@types/bcrypt": "^6.0.0",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/morgan": "^1.9.10",
		"@types/multer": "^2.2.0",
		"@types/node": "^26.1.0",
		"@types/nodemailer": "^8.0.1",
		"@types/swagger-ui-express": "^4.1.8",
		"cross-env": "^10.1.0",
		"dotenv": "^17.4.2",
		"prisma": "^7.8.0",
		"tsx": "^4.23.0",
		"typescript": "^6.0.3"
	}
}
