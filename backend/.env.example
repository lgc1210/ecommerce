# ==============================================================================
# LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Application Networking Settings
CLIENT_URL=
COOKIE_DOMAIN=

# Prisma Relational Database Connection (Target Local MySQL Instance)
# Syntax structure: mysql://user:password@host:port/database_name
DATABASE_URL=
DATABASE_SSL=

# Session Security Configuration Keys (Minimum 8 Characters required by your Zod schema)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Resend config
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Google OAuth
GOOGLE_CLIENT_ID=

# Facebook OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ONLINE PAYMENT
# Mã định danh website của bạn trên hệ thông VNPay (Thường gồm 8 ký tự chữ và số)
VNP_TMNCODE=
# Dùng để tạo chữ ký
VNP_HASHSECRET=
# Định cấu hình môi trường (sandbox hoặc live)
VNP_URL=
# khách về đây trước, backend verify chữ ký rồi mới redirect tiếp sang trang kết quả ở frontend.
VNP_RETURNURL=

# Mã đối tác do MoMo cung cấp khi đăng ký tài khoản doanh nghiệp
MOMO_PARTNER_CODE=
# Khoá truy cập dùng để định danh tài khoản khi gọi API
MOMO_ACCESS_KEY=
# Khoá bí mật dùng để tạo chữ ký điện tử (Signature) bằng thuật toán HMAC SHA256
MOMO_SECRET_KEY=
# 
MOMO_PUBLIC_KEY=
# Địa chỉ máy chủ MoMo để gửi yêu cầu thanh toán
MOMO_API_ENPOINT=
# URL của trang web mà MoMo sẽ chuyển hướng khách hàng quay trờ lại khi họ thực hiện thanh toán xong
MOMO_REDIRECT_URL=
# 
MOMO_IPN_URL=

# AppID môi trường sandbox (hoặc Production)
ZALOPAY_APP_ID=
# Dùng để tạo mã MAC gửi yêu cầu thanh toán
ZALOPAY_KEY1=
# Dùng để xác thực MAC khi nhận callback từ ZaloPay (Callback key)
ZALOPAY_KEY2=
# Gốc URL API ZaloPay (sandbox: https://sb-openapi.zalopay.vn)
ZALOPAY_ENDPOINT=
# URL FRONTEND (vd: http://localhost:5173/payment/result) — nơi khách về sau khi thanh toán xong.
# KHÔNG kèm chữ ký đáng tin cậy, chỉ dùng hiển thị UI tạm thời.
ZALOPAY_REDIRECT_URL=
# URL BACKEND công khai (vd: https://<ngrok-id>.ngrok-free.app/api/payments/zalopay/callback) để
# ZaloPay gọi server-to-server xác nhận thanh toán — PHẢI truy cập được từ internet khi phát triển
# local (dùng ngrok/cloudflared), vì ZaloPay sandbox không gọi được tới localhost.
ZALOPAY_CALLBACK_URL=

# Giao Hàng Nhanh
GHN_API_URL=
GHN_API_TOKEN=
GHN_SHOP_ID=
GHN_SERVICE_TYPE_ID= # Loại hàng nhẹ
GHN_FROM_DISTRICT_ID= # id quận của nơi gửi (người bán) 
GHN_FROM_WARD_CODE= # code phường của nơi gửi (người bán)

# Số giờ 1 đơn "pending" thanh toán online được giữ tồn kho trước khi tự động hủy nếu khách không
# thanh toán/không thử lại. Không áp dụng cho đơn COD.
PENDING_ORDER_TTL_HOURS=24
# Lịch job dọn đơn quá hạn ở trên (cú pháp cron). Mặc định: chạy đầu mỗi giờ.
PENDING_ORDER_CLEANUP_CRON=0 * * * *