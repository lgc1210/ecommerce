# ==============================================================================
# LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION
# Copy file này thành .env.development (hoặc .env.<NODE_ENV>) rồi điền giá trị thật.
# Toàn bộ biến bên dưới được validate bởi src/config/dotenv.ts (zod) khi server khởi
# động — thiếu hoặc sai định dạng bất kỳ biến bắt buộc nào sẽ khiến app crash ngay
# lúc start kèm log rõ tên biến lỗi.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application Networking Settings
# ------------------------------------------------------------------------------
# Gốc URL của frontend (vd: http://localhost:5173 khi dev, https://shop.example.com
# khi production). Dùng để redirect trình duyệt khách về trang kết quả thanh toán
# frontend (VNPay/ZaloPay return) và cấu hình CORS. Phải là URL hợp lệ.
CLIENT_URL=

# ------------------------------------------------------------------------------
# Prisma Relational Database Connection (Target Local MySQL Instance)
# ------------------------------------------------------------------------------
# Syntax structure: mysql://user:password@host:port/database_name
DATABASE_URL=

# ------------------------------------------------------------------------------
# Session Security Configuration Keys (Minimum 8 Characters required by your Zod schema)
# ------------------------------------------------------------------------------
# Khoá bí mật dùng để ký access token JWT. Tối thiểu 8 ký tự — nên dùng chuỗi random
# dài (32+ ký tự) ở production, không tái sử dụng giữa các môi trường.
JWT_SECRET=
# Khoá bí mật dùng để ký refresh token JWT. Phải khác JWT_SECRET để access token bị
# lộ không kéo theo refresh token cũng bị giả mạo được. Tối thiểu 8 ký tự.
JWT_REFRESH_SECRET=

# ------------------------------------------------------------------------------
# SMTP Developer Email Service Engine Settings (Example configured using Mailtrap)
# For local sandboxed testing without sending spam to real customers, use Mailtrap.io
# If using native Google App Passwords instead, flip host to: ://gmail.com and secure to: true
# ------------------------------------------------------------------------------
# Địa chỉ SMTP server (vd: sandbox.smtp.mailtrap.io hoặc smtp.gmail.com).
SMTP_HOST=
# Cổng SMTP (vd: 587 cho STARTTLS, 465 cho SSL/TLS trực tiếp).
SMTP_PORT=
# "true"/"false" — bật SSL/TLS trực tiếp khi kết nối (thường true nếu SMTP_PORT=465,
# false nếu dùng STARTTLS ở port 587). Đúng chuỗi "true" mới được coi là bật.
SMTP_SECURE=
# Tài khoản đăng nhập SMTP, phải là email hợp lệ (dùng làm địa chỉ "From" khi gửi mail).
SMTP_USER=
# Mật khẩu/App Password của tài khoản SMTP ở trên.
SMTP_PASS=

# ------------------------------------------------------------------------------
# Google OAuth
# ------------------------------------------------------------------------------
# Client ID (Web application) trên Google Cloud Console, dùng để xác thực idToken
# frontend gửi lên qua google-auth-library. Phải trùng với client ID cấu hình ở
# frontend (VITE_GOOGLE_CLIENT_ID) vì idToken chỉ cấp cho đúng 1 audience.
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# Facebook OAuth
# ------------------------------------------------------------------------------
# App ID + App Secret trên Facebook for Developers, dùng để tạo App Access Token
# (APP_ID|APP_SECRET) gọi Graph API "debug_token" xác minh accessToken frontend gửi
# lên thực sự thuộc về đúng app này.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ==============================================================================
# ONLINE PAYMENT
# ==============================================================================

# ------------------------------------------------------------------------------
# VNPay — https://sandbox.vnpayment.vn (đăng ký tài khoản demo để lấy TMN Code + Hash Secret)
# ------------------------------------------------------------------------------
# Mã định danh website của bạn trên hệ thống VNPay (thường gồm 8 ký tự chữ và số).
VNP_TMNCODE=
# Dùng để tạo chữ ký (HMAC) cho mọi request gửi đi và verify chữ ký VNPay trả về.
VNP_HASHSECRET=
# Gốc URL cổng thanh toán VNPay (sandbox: https://sandbox.vnpayment.vn/paymentv2/vpcpay.html,
# production đổi sang domain thật khi được VNPay duyệt).
VNP_URL=
# URL BACKEND (KHÔNG phải frontend) mà VNPay redirect trình duyệt khách về sau khi
# thanh toán xong — khách về đây trước, backend verify chữ ký rồi mới redirect tiếp
# sang trang kết quả ở frontend (CLIENT_URL).
VNP_RETURNURL=

# ------------------------------------------------------------------------------
# MoMo
# ------------------------------------------------------------------------------
# Mã đối tác do MoMo cung cấp khi đăng ký tài khoản doanh nghiệp.
MOMO_PARTNER_CODE=
# Khoá truy cập dùng để định danh tài khoản khi gọi API.
MOMO_ACCESS_KEY=
# Khoá bí mật dùng để tạo chữ ký điện tử (Signature) bằng thuật toán HMAC SHA256.
MOMO_SECRET_KEY=
# Khoá công khai MoMo cấp, dùng khi cần verify/mã hoá theo phương thức RSA (tuỳ luồng
# tích hợp có dùng hay không).
MOMO_PUBLIC_KEY=
# Địa chỉ máy chủ MoMo để gửi yêu cầu thanh toán (sandbox:
# https://test-payment.momo.vn/v2/gateway/api/create).
MOMO_API_ENPOINT=
# URL FRONTEND mà MoMo sẽ chuyển hướng khách hàng quay trở lại sau khi thực hiện
# thanh toán xong. Chỉ dùng hiển thị UI tạm thời, không dùng để cập nhật trạng thái đơn hàng.
MOMO_REDIRECT_URL=
# URL BACKEND công khai để MoMo gọi server-to-server xác nhận thanh toán (IPN) — PHẢI
# là URL truy cập được từ internet (dùng ngrok/tunnel khi phát triển local).
MOMO_IPN_URL=

# ------------------------------------------------------------------------------
# ZaloPay — https://docs.zalopay.vn
# ------------------------------------------------------------------------------
# AppID môi trường sandbox (hoặc Production). PHẢI cùng môi trường với ZALOPAY_KEY1/2
# và ZALOPAY_ENDPOINT bên dưới — lệch môi trường là nguyên nhân phổ biến nhất khiến
# giao dịch tạo được order_url nhưng báo lỗi hệ thống khi thanh toán thật trên trang ZaloPay.
ZALOPAY_APP_ID=
# Dùng để tạo mã MAC gửi yêu cầu thanh toán (ký request /v2/create).
ZALOPAY_KEY1=
# Dùng để xác thực MAC khi nhận callback (IPN) từ ZaloPay — không khớp thì callback
# bị coi là không hợp lệ và đơn hàng sẽ không bao giờ được xác nhận thanh toán.
ZALOPAY_KEY2=
# Gốc URL API ZaloPay (sandbox: https://sb-openapi.zalopay.vn, production:
# https://openapi.zalopay.vn). Phải khớp môi trường với ZALOPAY_APP_ID/KEY1/KEY2.
ZALOPAY_ENDPOINT=
# URL FRONTEND (vd: http://localhost:5173/payment/result) — nơi khách về sau khi
# thanh toán xong. KHÔNG kèm chữ ký đáng tin cậy, chỉ dùng hiển thị UI tạm thời,
# KHÔNG dùng để cập nhật trạng thái đơn hàng trong DB.
ZALOPAY_REDIRECT_URL=
# URL BACKEND công khai (vd: https://<ngrok-id>.ngrok-free.app/api/payments/zalopay/callback)
# để ZaloPay gọi server-to-server xác nhận thanh toán — PHẢI truy cập được từ internet
# khi phát triển local (dùng ngrok/cloudflared), vì ZaloPay sandbox không gọi được tới localhost.
ZALOPAY_CALLBACK_URL=

# ==============================================================================
# Giao Hàng Nhanh (GHN)
# ==============================================================================
# Gốc URL API GHN (sandbox: https://dev-online-gateway.ghn.vn, production:
# https://online-gateway.ghn.vn).
GHN_API_URL=
# Token API do GHN cấp trong trang quản lý shop, gửi kèm header "Token" mỗi request.
GHN_API_TOKEN=
# ID shop trên hệ thống GHN (lấy trong trang quản lý shop GHN).
GHN_SHOP_ID=
# ID loại dịch vụ vận chuyển GHN dùng để tính phí/tạo đơn (vd dịch vụ hàng nhẹ chuẩn).
GHN_SERVICE_TYPE_ID=
# ID quận/huyện nơi gửi hàng (kho/người bán), dùng để GHN tính phí ship và tạo đơn.
GHN_FROM_DISTRICT_ID=
# Mã phường/xã nơi gửi hàng (kho/người bán), dùng để GHN tính phí ship và tạo đơn.
GHN_FROM_WARD_CODE=

# ==============================================================================
# Housekeeping
# ==============================================================================
# Số giờ 1 đơn "pending" thanh toán online được giữ tồn kho trước khi tự động huỷ nếu
# khách không thanh toán/không thử lại. Không áp dụng cho đơn COD. Có default = 24
# nên không bắt buộc khai báo trong .env.
PENDING_ORDER_TTL_HOURS=24
# Lịch chạy job dọn đơn quá hạn ở trên (cú pháp cron). Mặc định: chạy đầu mỗi giờ.
PENDING_ORDER_CLEANUP_CRON=0 * * * *
