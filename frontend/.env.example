# ==============================================================================
# FRONTEND ENVIRONMENT CONFIGURATION (Vite)
# Copy file này thành .env (hoặc .env.development / .env.production) rồi điền giá trị
# thật. Vite chỉ nạp các biến có tiền tố "VITE_" vào bundle (import.meta.env.*) — biến
# không có tiền tố này sẽ KHÔNG được expose ra phía client, dù có khai báo cũng vô tác dụng.
# LƯU Ý: mọi giá trị VITE_* đều bị đóng gói thẳng vào file JS public, ai mở DevTools cũng
# đọc được — tuyệt đối KHÔNG để secret key/token bí mật ở đây, chỉ chứa các ID/URL public.
# ==============================================================================

# ------------------------------------------------------------------------------
# API Backend
# ------------------------------------------------------------------------------
# Gốc URL của backend Express (vd: http://localhost:5000/api khi dev,
# https://api.example.com khi production) — nơi frontend gọi mọi API nghiệp vụ
# (auth, order, payment, product...).
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# Strapi CMS
# ------------------------------------------------------------------------------
# Gốc URL của Strapi instance (vd: http://localhost:1337 khi dev) — dùng để lấy nội
# dung quản lý qua CMS (bài viết, banner, trang tĩnh...) và ghép đường dẫn ảnh/media
# do Strapi trả về (media path của Strapi thường là đường dẫn tương đối, cần nối với
# gốc URL này mới ra được URL ảnh đầy đủ).
VITE_STRAPI_BASE_URL=

# ------------------------------------------------------------------------------
# Google OAuth
# ------------------------------------------------------------------------------
# Client ID (Web application) trên Google Cloud Console, dùng để khởi tạo nút đăng
# nhập Google ở frontend (Google Identity Services) và lấy idToken gửi lên backend
# xác thực. PHẢI trùng với GOOGLE_CLIENT_ID ở backend vì idToken chỉ cấp cho đúng 1
# audience (client ID) — lệch client ID thì backend sẽ từ chối idToken.
VITE_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# Facebook Login SDK
# ------------------------------------------------------------------------------
# App ID trên Facebook for Developers, dùng để khởi tạo Facebook SDK (FB.init) và nút
# đăng nhập Facebook ở frontend. PHẢI trùng với FACEBOOK_APP_ID ở backend vì backend
# dùng App ID này (kèm App Secret) để verify accessToken frontend gửi lên có thực sự
# thuộc về đúng app này hay không.
VITE_FACEBOOK_APP_ID=
# ID của thẻ <script> nhúng Facebook SDK vào DOM (window.fbAsyncInit cần thẻ script
# này tồn tại đúng ID để load SDK, tránh nhúng trùng nhiều lần khi component re-render).
VITE_FACEBOOK_SDK_SCRIPT_ID=
# URL file JS của Facebook SDK cần nhúng (vd:
# https://connect.facebook.net/vi_VN/sdk.js) — đổi locale trong URL này để đổi ngôn
# ngữ hiển thị của các dialog/nút do SDK render.
VITE_FACEBOOK_SDK_SRC=
# Phiên bản Graph API mà Facebook SDK sẽ dùng khi gọi FB.init (vd: v19.0) — phải là
# version còn được Facebook hỗ trợ, version quá cũ sẽ bị Facebook ngừng phục vụ.
VITE_FACEBOOK_SDK_VERSION=
